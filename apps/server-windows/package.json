{
  "name": "eliminacode-server-windows",
  "version": "1.2.3",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "test:browser": "node test/browser.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "com.eliminacode.server",
    "productName": "Eliminacode Server",
    "files": [
      "main.cjs",
      "server.cjs",
      "preload.cjs",
      "public/**/*",
      "assets/**/*",
      "README.md",
      "package.json",
      "wait-times.cjs",
      "push.cjs",
      "tunnel.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "vendor/cloudflared.exe",
        "to": "cloudflared.exe"
      }
    ]
  }
}
